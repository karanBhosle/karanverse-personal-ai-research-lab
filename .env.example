# Application
APP_NAME=karanVerse Research Lab
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Data paths (defaults: project_root/data/processed and data/raw)
# DATA_PROCESSED_DIR=
# DATA_RAW_DIR=

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CHUNK_MIN_SIZE=50

# BM25 sparse index (default: project_root/data/index/bm25)
# BM25_INDEX_DIR=

# Qdrant + dense retrieval
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=research_chunks
QDRANT_INDEXING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DIMENSION=384
VECTOR_SEARCH_TOP_K=10

# Hybrid RRF
RRF_K=60
HYBRID_BM25_WEIGHT=1.0
HYBRID_VECTOR_WEIGHT=1.0
HYBRID_CANDIDATE_POOL=50

# Cross-encoder reranking (after hybrid RRF)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_COUNT=30
RERANK_FINAL_TOP_K=10

# LLM provider (credentials only in .env — never commit secrets)
LLM_PROVIDER=openrouter
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.0

# OpenRouter (recommended; copy values from your portfolio app into local .env)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_NAME=karanVerse Research Lab
# OPENROUTER_SITE_URL=https://your-site.example

# OmniRouter (set LLM_PROVIDER=omnirouter)
# OMNIROUTER_API_KEY=
# OMNIROUTER_BASE_URL=
# OMNIROUTER_MODEL=google/gemini-2.0-flash-001

# Direct Gemini (set LLM_PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Local Ollama (set LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# OpenAlex external literature (no credentials required; mailto improves rate limits)
OPENALEX_BASE_URL=https://api.openalex.org
# OPENALEX_MAILTO=you@example.com
OPENALEX_CACHE_ENABLED=true
OPENALEX_CACHE_TTL_SECONDS=86400

# arXiv external literature (no credentials required)
ARXIV_BASE_URL=https://export.arxiv.org/api
ARXIV_CACHE_ENABLED=true
ARXIV_CACHE_TTL_SECONDS=86400

# Research Planner agent (structured LLM output)
# RESEARCH_PLANNER_TEMPERATURE=0.2

# Research agent (evidence collection graph)
# RESEARCH_AGENT_PAPERS_PER_QUERY=5
# RESEARCH_AGENT_EVIDENCE_TOP_K=5

# Critic agent
# CRITIC_MIN_EVIDENCE_COUNT=2
# CRITIC_TEMPERATURE=0.1

# Research synthesizer agent
# SYNTHESIZER_TEMPERATURE=0.15

# Full research workflow
# RESEARCH_MAX_ITERATIONS=2

# Personal knowledge (portfolio seed: data/personal/portfolio_seed.json)
# Sync from https://github.com/karanBhosle/portpolio-app/tree/main/src/data when updating seed JSON

# Research history (JSON files under data/research_history by default)
# RESEARCH_HISTORY_DIR=data/research_history
# RESEARCH_HISTORY_CONTEXT_TOP_K=3
# RESEARCH_UPDATE_TEMPERATURE=0.15
# RESEARCH_UPDATE_MAX_EXCERPT_CHARS=500
# KNOWLEDGE_GAP_TEMPERATURE=0.15
# KNOWLEDGE_GAP_MAX_EXCERPT_CHARS=450
# KNOWLEDGE_GAP_LOW_EVIDENCE_THRESHOLD=3
# KNOWLEDGE_GAP_WEAK_SCORE_THRESHOLD=0.25

# Neo4j knowledge graph (optional; app runs without it)
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
# NEO4J_DATABASE=neo4j

# Security (defaults are safe for local dev; tighten for shared deployments)
# API_AUTH_ENABLED=false
# API_KEY=
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MAX_UPLOAD_BYTES=25000000
# MAX_INGEST_TEXT_CHARS=500000
# PDF_MAX_PAGES=500
RESEARCH_ALLOW_PRIVATE_KNOWLEDGE=false
EXTERNAL_LLM_ALLOW_PRIVATE_KNOWLEDGE=false

# Langfuse observability (optional; app runs without credentials)
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
